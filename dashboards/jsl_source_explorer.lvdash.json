{
  "datasets": [
    {
      "name": "adr",
      "displayName": "JSL product-reaction reference",
      "catalog": "john_snow_labs_adverse_drug_and_product_reaction",
      "schema": "drug_and_product_reaction",
      "config": {
        "source": "john_snow_labs_adverse_drug_and_product_reaction.drug_and_product_reaction.adverse_reaction_with_preferred_term_and_system_organ_class_codes",
        "measures": [
          {
            "name": "rows",
            "expr": "COUNT(1)"
          },
          {
            "name": "products",
            "expr": "COUNT(DISTINCT Medicinal_Product)"
          },
          {
            "name": "substances",
            "expr": "COUNT(DISTINCT Active_Substance)"
          },
          {
            "name": "reaction_terms",
            "expr": "COUNT(DISTINCT Adverse_Drug_Reaction_Term)"
          },
          {
            "name": "meddra_pts",
            "expr": "COUNT(DISTINCT MedDRA_PT_Code)"
          }
        ],
        "version": "1.1",
        "comment": "Reference rows, NOT incident counts, causality proof or live adverse-event reports; Date_Of_Most_Recent_SPC is the label/SPC date.",
        "dimensions": [
          {
            "name": "Is_Clinical_Trial",
            "expr": "Is_Clinical_Trial"
          },
          {
            "name": "Is_Post_Marketing_Surveillance",
            "expr": "Is_Post_Marketing_Surveillance"
          },
          {
            "name": "Is_Class_Warning",
            "expr": "Is_Class_Warning"
          },
          {
            "name": "Frequency",
            "expr": "Frequency"
          },
          {
            "name": "Causality",
            "expr": "Causality"
          },
          {
            "name": "Age_Group",
            "expr": "Age_Group"
          },
          {
            "name": "Gender",
            "expr": "Gender"
          }
        ]
      }
    },
    {
      "name": "chemicals",
      "displayName": "JSL chemical-disease evidence",
      "catalog": "john_snow_labs_adverse_drug_and_product_reaction",
      "schema": "drug_and_product_reaction",
      "config": {
        "source": "john_snow_labs_adverse_drug_and_product_reaction.drug_and_product_reaction.chemicals_contributing_to_disease",
        "measures": [
          {
            "name": "relations",
            "expr": "COUNT(1)"
          },
          {
            "name": "distinct_chemicals",
            "expr": "COUNT(DISTINCT Chemical_Id)"
          },
          {
            "name": "distinct_diseases",
            "expr": "COUNT(DISTINCT Disease_Id)"
          }
        ],
        "version": "1.1",
        "comment": "Literature-annotated relations, not clinical causality or observed incident counts.",
        "dimensions": [
          {
            "name": "Patient_Relation_Type",
            "expr": "Patient_Relation_Type"
          },
          {
            "name": "Patient_Relation_Type_Verification",
            "expr": "Patient_Relation_Type_Verification"
          }
        ]
      }
    },
    {
      "name": "narrative_relations",
      "displayName": "JSL patient narrative relation labels",
      "catalog": "john_snow_labs_adverse_drug_and_product_reaction",
      "schema": "drug_and_product_reaction",
      "config": {
        "source": "john_snow_labs_adverse_drug_and_product_reaction.drug_and_product_reaction.drug_relationship_database",
        "measures": [
          {
            "name": "relations",
            "expr": "COUNT(1)"
          },
          {
            "name": "documents",
            "expr": "COUNT(DISTINCT Document_Id)"
          }
        ],
        "version": "1.1",
        "comment": "Aggregated relationship labels only. Do not expose Remarks_by_Patient: free text may include personal data.",
        "dimensions": [
          {
            "name": "Patient_Relation_Type",
            "expr": "Patient_Relation_Type"
          },
          {
            "name": "Patient_Relation_Description",
            "expr": "Patient_Relation_Description"
          }
        ]
      }
    }
  ],
