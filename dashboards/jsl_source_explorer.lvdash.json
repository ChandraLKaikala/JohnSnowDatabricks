{
  "datasets": [
    {
      "name": "adr",
      "displayName": "JSL product-reaction reference",
      "queryLines": [
        "SELECT `Medicinal_Product`, `Active_Substance`, `Adverse_Drug_Reaction_Term`, `MedDRA_PT_Code`, `Is_Clinical_Trial`, `Is_Post_Marketing_Surveillance`, `Is_Class_Warning`, `Frequency`, `Causality` FROM `john_snow_labs_adverse_drug_and_product_reaction`.`drug_and_product_reaction`.`adverse_reaction_with_preferred_term_and_system_organ_class_codes`"
      ]
    },
    {
      "name": "chemicals",
      "displayName": "JSL chemical-disease evidence",
      "queryLines": [
        "SELECT `Chemical_Id`, `Disease_Id`, `Patient_Relation_Type`, `Patient_Relation_Type_Verification` FROM `john_snow_labs_adverse_drug_and_product_reaction`.`drug_and_product_reaction`.`chemicals_contributing_to_disease`"
      ]
    },
    {
      "name": "narrative_relations",
      "displayName": "JSL patient narrative relation labels",
      "queryLines": [
        "SELECT `Document_Id`, `Patient_Relation_Type`, `Patient_Relation_Description` FROM `john_snow_labs_adverse_drug_and_product_reaction`.`drug_and_product_reaction`.`drug_relationship_database`"
      ]
    }
  ],
